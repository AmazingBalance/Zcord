# Zcord Backend Environment Variables
# Скопируйте этот файл в .env и настройте значения

# JWT Secret Key (ОБЯЗАТЕЛЬНО измените в production!)
# Используйте длинный случайный ключ минимум 32 символа
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars

# Database Connection
# Для Docker: используйте имя сервиса 'postgres'
# Для локальной разработки: используйте 'localhost'
DATABASE_URL=postgres://zcord:CHANGE_ME@postgres:5432/zcord?sslmode=disable

# Application Environment
# development | production | testing
APP_ENV=development

# Server Configuration
SERVER_PORT=8000

# CORS Settings
# В production укажите ваш домен
CORS_ORIGIN=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB в байтах
UPLOAD_DIR=./uploads

# Database Settings (для docker-compose)
POSTGRES_DB=zcord
POSTGRES_USER=zcord
POSTGRES_PASSWORD=change-me

# Security Settings
# Включить HTTPS в production
ENABLE_HTTPS=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Logging
LOG_LEVEL=info  # debug | info | warn | error
LOG_FORMAT=json  # json | text

# Rate Limiting
RATE_LIMIT_REQUESTS=60  # запросов в минуту
RATE_LIMIT_WINDOW=60    # окно в секундах

# Session Settings
SESSION_TIMEOUT=86400   # 24 часа в секундах