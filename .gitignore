# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (templates stay tracked, real .env never)
.env*
!.env.example

# local database data — never commit
/my_postgres_data/

# compiled backend binaries
/server/zcord
/server/zcord-server
/server/zcord.exe

# logs
*.log
/server/logs/
nohup.out
devserver-*.log

# user uploads (runtime data)
/server/uploads/*
!/server/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
temp_kinopoisk.html
