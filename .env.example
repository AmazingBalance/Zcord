# Zcord production/cloud environment
#
# Copy to `.env` and edit values before running `docker compose up -d --build`.

# --- Backend ---
# IMPORTANT: change in production (>= 32 chars recommended).
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs (used by backend to return absolute URLs for /uploads)
PUBLIC_API_URL=https://zcord.example.com
PUBLIC_WEB_URL=https://zcord.example.com

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://zcord.example.com

# Bootstrap accounts (created on backend start if missing)
BOOTSTRAP_ROOT_EMAIL=root@example.invalid
BOOTSTRAP_ROOT_PASSWORD=change-me
BOOTSTRAP_NIKDIMER_EMAIL=nikdimer@example.invalid
BOOTSTRAP_NIKDIMER_PASSWORD=change-me

# --- Frontend build ---
# Used in client bundle to call the backend API (set to the PUBLIC site URL if you proxy backend under the same domain).
NEXT_PUBLIC_API_URL=https://zcord.example.com

# --- Postgres ---
POSTGRES_DB=zcord
POSTGRES_USER=zcord
POSTGRES_PASSWORD=change-me

# Optional ports (compose defaults)
POSTGRES_PORT=5435
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Reverse proxy (docker-compose.cloud.yml) ---
ZCORD_DOMAIN=zcord.example.com
# Optional (Let's Encrypt account email)
CADDY_EMAIL=admin@zcord.example.com
